<?xml version="1.0" encoding="utf-8"?>
<!--
   Правила автобэкапа для Android 11 и ниже (API < 31).
   Подключается через android:fullBackupContent в AndroidManifest.

   Логи исключаются: FileLoggingTree пишет в filesDir/logs/, и при
   дефолтных правилах они бы уехали в Google Drive автобэкап.
   После redaction PII (коммит fix(privacy)) в логах не остаётся
   user input, но логи всё равно исключаем: они шум, не user data.
-->
<full-backup-content>
    <exclude domain="file" path="logs" />
</full-backup-content>
