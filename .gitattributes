# Default: auto-detect, normalize to LF in repo
* text=auto eol=lf

# Shell scripts — MUST be LF
*.sh text eol=lf
*.bash text eol=lf

# Git hooks
.githooks/* text eol=lf

# Kotlin, Gradle, Markdown — LF
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Windows batch — CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.jks binary
*.keystore binary
*.jar binary
*.zip binary
