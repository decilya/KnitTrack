#!/bin/bash
# KnitTrac pre-commit hook.
# Запускает тесты и detekt через Windows gradlew.bat.
# WSL-safe: не использует ./gradlew (bash) на drvfs /mnt/c —
# это даёт Input/output error из-за антивируса.
set -e

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
PROJECT_WIN="$(wslpath -w "$PROJECT_DIR")"

echo "[pre-commit] Running gradlew.bat test detekt..."
cmd.exe /C "cd /D $PROJECT_WIN && gradlew.bat test detekt --console=plain"
