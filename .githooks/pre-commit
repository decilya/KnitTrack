#!/bin/bash
# KnitTrac pre-commit hook.
# Запускает тесты и detekt перед коммитом.
# Активируется через: git config core.hooksPath .githooks
set -e

if [[ "$(uname -s)" == MINGW* || "$(uname -s)" == MSYS* || "$(uname -s)" == CYGWIN* ]]; then
    # Windows Git Bash
    ./gradlew.bat test detekt
else
    # WSL / Linux / macOS
    ./gradlew test detekt
fi
